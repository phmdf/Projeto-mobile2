<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarAtendimento"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#000000"
            android:title="@string/budget"
            android:titleTextColor="@android:color/white" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardBackgroundColor="#1F2937">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/txtOS"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OS #00125"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white" />

                    <TextView
                        android:id="@+id/txtStatusOS"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/in_progress"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#60A5FA"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/txtPrazo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prazo previsto: 05/09/2026"
                        android:textColor="@android:color/white"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vehicle"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_marginTop="22dp" />

            <TextView
                android:id="@+id/txtDadosVeiculo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Honda Civic 2022\nABC-1234\n120.450 km"
                android:textSize="15sp"
                android:textColor="@android:color/white"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reported_problem"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_marginTop="22dp" />

            <TextView
                android:id="@+id/txtProblema"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cliente informou ruído na parte dianteira."
                android:textColor="@android:color/white"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diagnosis"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_marginTop="22dp" />

            <TextView
                android:id="@+id/txtDiagnostico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Diagnóstico registrado pelo mecânico."
                android:textColor="@android:color/white"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/services"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_marginTop="22dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerServicos"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/budget"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/txtValor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total: R$ 850,00"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#34D399"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>